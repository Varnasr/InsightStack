<?xml version="1.0" encoding="UTF-8"?>
<vensim_model>
  <variables>
    <variable>
      <name>Income_Stability</name>
      <equation>INIT(50)</equation>
      <units>index</units>
      <comment>Represents baseline income regularity</comment>
    </variable>
    <variable>
      <name>Social_Support</name>
      <equation>1.5</equation>
      <units>support index</units>
    </variable>
    <variable>
      <name>Shock_Exposure</name>
      <equation>2</equation>
      <units>shock index</units>
    </variable>
    <variable>
      <name>Resilience_Capacity</name>
      <equation>Income_Stability * Social_Support / Shock_Exposure</equation>
      <units>index</units>
    </variable>
    <variable>
      <name>Skill_Investment</name>
      <equation>10</equation>
      <units>units/day</units>
    </variable>
    <variable>
      <name>Income_Improvement_Rate</name>
      <equation>0.02 * Skill_Investment</equation>
    </variable>
    <variable>
      <name>dIncome_Stability/dt</name>
      <equation>Income_Improvement_Rate - 0.01 * Shock_Exposure</equation>
    </variable>
  </variables>
  <flows>
    <flow>
      <source>Income_Stability</source>
      <destination>Income_Stability</destination>
      <equation>dIncome_Stability/dt</equation>
    </flow>
  </flows>
</vensim_model>
